# Production settings for AWS (EC2 + Docker Compose) with MongoDB Atlas and S3.
# Non-secret values stay here. Secrets (marked SECRET) are normally stored in AWS SSM Parameter Store under /careerpilot/
# and merged in by deploy/fetch_secrets.sh, so this file never needs to hold them in git.
APP_ENV=production
# images pulled from ECR (set by deploy/ec2-bootstrap.sh)
ECR_REGISTRY=217856377501.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=latest
# keys are re-read from Parameter Store every 60 s: rotate a key in the console, no redeploy
SECRETS_BACKEND=ssm
USER_DAILY_RUNS=20
LOG_FORMAT=json

# --- public address (Caddy). ":80" = HTTP on the IP; "app.example.com" or "<ip-with-dashes>.sslip.io" = automatic HTTPS
SITE_ADDRESS=:80
CORS_ORIGINS=http://YOUR_ELASTIC_IP

# --- database: MongoDB Atlas (allow only this server's Elastic IP in Atlas Network Access)
# SECRET
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=careerpilot

# --- files: real S3. Leave S3_ENDPOINT_URL empty; access comes from the EC2 instance role (no keys)
S3_BUCKET=careerpilot-217856377501-aps1
S3_ENDPOINT_URL=
AWS_REGION=ap-south-1

# --- auth
# SECRET, at least 32 characters
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32

# --- models
LLM_PROVIDER=groq
# SECRET
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional fallback when Groq is rate limited (uses its own quota):
# SECRET, optional
OPENROUTER_API_KEY=
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_HOME=/models

# --- observability (optional)
LANGSMITH_TRACING=false
# SECRET, optional
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careerpilot

# --- jobs and GitHub
JOBS_SOURCE=auto
JOBS_DEFAULT_LOCATION=India
# SECRET, optional Adzuna "app_id:app_key"; the app hard-caps itself below the key's 25 total calls
JOBS_API_KEY=
JOBS_ADZUNA_MAX_CALLS=20
# SECRET, optional (free on request, good India coverage)
JOOBLE_API_KEY=
# SECRET, optional: public repos work without it (60 requests per hour)
GITHUB_TOKEN=

# --- internal wiring (docker-compose.prod.yml sets MCP_SERVER_URL, CHROMA_DIR)
MCP_MODE=auto
AGENT_MAX_STEPS_RETRIEVAL=5
AGENT_MAX_STEPS_JOBS=4
SESSION_EXPIRY_HOURS=24
