GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careerpilot
GITHUB_TOKEN=
JOBS_API_KEY=
CHROMA_DIR=./.chroma
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_HOME=./.hf_cache
AGENT_MAX_STEPS_RETRIEVAL=5
AGENT_MAX_STEPS_JOBS=4
SESSION_EXPIRY_HOURS=24
JOBS_TOP_N=20
JOBS_MIN_SCORE=0.5
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=careerpilot
JWT_SECRET=change-me-in-real-envs
S3_BUCKET=careerpilot-data
S3_ENDPOINT_URL=http://minio:9000
AWS_REGION=ap-south-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MCP_SERVER_URL=http://mcp:8001/mcp
CORS_ORIGINS=http://localhost:5173
BACKEND_HOST_PORT=8000

# Chat provider: groq or gemini. Embeddings: local (sentence-transformers, no key) or gemini.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
MCP_MODE=auto
FRONTEND_HOST_PORT=8180

# Jobs: JOBS_SOURCE=auto uses all free sources. Optional paid-signup source: Adzuna (JOBS_API_KEY=app_id:app_key, JOBS_COUNTRY=in).
JOBS_SOURCE=auto
JOBS_COUNTRY=in
# Optional: other Groq models tried when the main one is rate limited (the 20b model was unreliable for structured output).
GROQ_FALLBACK_MODELS=

# Optional: OpenRouter free model used when Groq is rate limited, or as the main model with LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Jobs: free sources (RemoteOK, Remotive, Arbeitnow, Jobicy, Himalayas) need no key. Optional: JOOBLE_API_KEY (free on request, strong India coverage).
JOBS_DEFAULT_LOCATION=India
JOOBLE_API_KEY=
